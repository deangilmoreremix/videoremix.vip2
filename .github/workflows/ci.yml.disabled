# DISABLED (GitHub Actions retirement, 2026-10-12): this account is billing-locked so no job ever starts,
# and Netlify is now the only build/test/deploy platform — the lint/vitest/build gate runs on every
# Netlify build. Renamed to `.disabled` (content preserved for audit); see docs/NETLIFY-CICD.md.
name: CI/CD Pipeline

on:
  push:
    branches: [main, develop]
  # PRs must be gated by the full pipeline no matter which branch they target.
  # `pull_request.branches` filters on the PR BASE branch, so restricting it to
  # main/develop silently skips CI for release branches (e.g. PRs targeting
  # fix/sapienx-130-app-catalog). Deliberately unfiltered: every PR is gated.
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]

jobs:
  build-and-test:
    runs-on: ubuntu-latest
    
    strategy:
      matrix:
        node-version: [20.x]
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Setup Node.js ${{ matrix.node-version }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node-version }}
          cache: 'npm'
      
      - name: Install dependencies
        run: npm ci
      
      - name: Run linter
        run: npm run lint
      
      # Legacy type debt: ~1.6k pre-existing errors repo-wide; tracked separately from the build gate.
      # Type check is reported here but kept non-blocking until the baseline is burned down.
      - name: Run type check
        run: npx tsc --noEmit
        continue-on-error: true
      
      - name: Run tests
        run: npm test -- --run
      
      - name: Build project
        run: npm run build
        env:
          VITE_SUPABASE_URL: ${{ secrets.VITE_SUPABASE_URL }}
          VITE_SUPABASE_ANON_KEY: ${{ secrets.VITE_SUPABASE_ANON_KEY }}
      
      - name: Upload build artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: build-output
          path: dist/
          retention-days: 7
